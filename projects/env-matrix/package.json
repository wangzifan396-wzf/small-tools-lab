{
  "name": "env-matrix",
  "version": "0.1.0",
  "description": "Map environment-variable contracts across source, examples, CI, containers, and docs.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangzifan396-wzf/small-tools-lab.git",
    "directory": "projects/env-matrix"
  },
  "homepage": "https://github.com/wangzifan396-wzf/small-tools-lab/tree/main/projects/env-matrix#readme",
  "bugs": "https://github.com/wangzifan396-wzf/small-tools-lab/issues",
  "bin": {
    "env-matrix": "bin/env-matrix.js",
    "envmatrix": "bin/env-matrix.js"
  },
  "files": [
