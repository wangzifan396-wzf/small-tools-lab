    "src/",
    "docs/env-matrix-report.png",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "configuration",
    "dotenv",
    "environment-variables",
    "github-actions",
    "linter",
    "twelve-factor",
    "validation"
