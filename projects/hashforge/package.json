{
  "name": "hashforge",
  "version": "0.1.0",
  "description": "Zero-dependency hashing, HMAC and codec toolkit — SHA-1/256/384/512, HMAC, base64/hex — runs in Node and the browser via Web Crypto.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./playground": "./playground/index.html"
  },
  "bin": {
    "hashforge": "bin/hashforge.js"
  },
  "files": [
    "src",
    "bin",
    "types",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node bin/hashforge.js hash \"hello\" && node bin/hashforge.js encode \"hi\" --enc base64",
    "playground": "node playground/serve.js"
  },
  "keywords": [
    "hash",
    "sha256",
    "sha512",
    "hmac",
    "checksum",
    "base64",
    "crypto",
    "webcrypto",
    "zerodep",
    "cli"
  ],
  "author": "WorkBuddy",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wangzifan396-wzf/small-tools-lab"
  }
}
