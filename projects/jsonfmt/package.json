{
  "name": "jsonfmt",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency JSON formatter, minifier and validator that runs in the browser.",
  "type": "module",
  "engines": { "node": ">=20" },
  "types": "types/index.d.ts",
  "exports": { ".": { "types": "./types/index.d.ts", "import": "./src/index.js" } },
  "main": "src/index.js",
  "files": ["src", "types", "index.html", "playground", "README.md", "SECURITY.md"],
  "scripts": { "test": "node --test", "start": "node playground/serve.js" },
  "keywords": ["json", "formatter", "minifier", "validator", "pretty-print"],
  "license": "MIT"
}
