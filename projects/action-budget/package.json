{
  "name": "action-budget",
  "version": "0.1.0",
  "description": "Make GitHub Actions matrix fanout, concurrency, and timeout exposure visible before a workflow runs.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangzifan396-wzf/small-tools-lab.git",
    "directory": "projects/action-budget"
  },
  "homepage": "https://github.com/wangzifan396-wzf/small-tools-lab/tree/main/projects/action-budget#readme",
  "bugs": "https://github.com/wangzifan396-wzf/small-tools-lab/issues",
  "bin": {
    "action-budget": "bin/action-budget.js",
    "actionbudget": "bin/action-budget.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/action-budget-report.png",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "ci",
    "cost",
    "github-actions",
    "linter",
    "matrix",
    "workflow"
  ],
  "scripts": {
    "check": "node --check bin/action-budget.js && node --check src/analyzer.js && node --check src/reporters.js",
    "test": "node --test tests/*.test.js",
    "demo": "node bin/action-budget.js examples/expensive-ci --format html --output action-budget-report.html --fail-on none"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
