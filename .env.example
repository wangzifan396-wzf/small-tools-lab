# Optional Python launcher used by the root test runner.
PYTHON=python3

# Shared default for local browser-tool preview servers.
PORT=4173

# Local KB defaults.
KB_OLLAMA_HOST=http://127.0.0.1:11434
KB_CHAT_MODEL=qwen3.5:4b
KB_EMBED_MODEL=nomic-embed-text
KB_TOP_K=5

# Screenshot QA defaults. Leave the API key empty unless using DeepSeek.
SCREENSHOT_QA_OLLAMA_HOST=http://127.0.0.1:11434
SCREENSHOT_QA_OLLAMA_MODEL=qwen3.5:4b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
